<?xml version="1.0" encoding="utf-8" ?>
<Defs>

	<!-- *=*=*=*=*=*=*=*=*=*=*=*=*=*=*=*=*=*=*=*=*=*=*=*=*=*=*=*=*=*
	     Existing orbital buildings
	     *=*=*=*=*=*=*=*=*=*=*=*=*=*=*=*=*=*=*=*=*=*=*=*=*=*=*=*=*=* -->

	<FactionColonies.BuildingFCDef ParentName="BuildingFCDef_Orbital" MayRequire="Ludeon.RimWorld.Odyssey">
		<defName>orbitalFuelDepot</defName>
		<label>Orbital Fuel Depot</label>
		<desc>Stores and processes fuel for spacecraft. Essential for maintaining orbital operations and supporting space travel.</desc>
		<cost>2000</cost>
		<techLevel>Spacer</techLevel>
		<constructionDuration>300000</constructionDuration>
		<statModifiers>
			<li><stat>RTD_Power_ProductionAdditive</stat><value>0.5</value></li>
			<li><stat>RTD_Chemfuel_ProductionAdditive</stat><value>0.5</value></li>
		</statModifiers>
		<upkeep>80</upkeep>
		<postRework>true</postRework>
		<iconPath>GUI/Buildings/Orbital/OrbitalFuelDepot</iconPath>
	</FactionColonies.BuildingFCDef>

	<FactionColonies.BuildingFCDef ParentName="BuildingFCDef_Orbital" MayRequire="Ludeon.RimWorld.Odyssey">
		<defName>asteroidMiningPlatform</defName>
		<label>Asteroid Mining Platform</label>
		<desc>Automated mining drones harvest resources from nearby asteroids and space debris. Much more efficient than planetary mining.</desc>
		<cost>3500</cost>
		<techLevel>Spacer</techLevel>
		<constructionDuration>300000</constructionDuration>
		<statModifiers>
			<li><stat>RTD_Mining_ProductionAdditive</stat><value>0.8</value></li>
		</statModifiers>
		<upkeep>80</upkeep>
		<postRework>true</postRework>
		<iconPath>GUI/Buildings/Orbital/asteroidMining</iconPath>
	</FactionColonies.BuildingFCDef>

	<FactionColonies.BuildingFCDef ParentName="BuildingFCDef_Orbital" MayRequire="Ludeon.RimWorld.Odyssey">
		<defName>solarCollectionArray</defName>
		<label>Solar Collection Array</label>
		<desc>Massive solar panel arrays with no atmospheric interference collect energy directly from the star. Powers the station and provides surplus energy.</desc>
		<cost>7500</cost>
		<techLevel>Spacer</techLevel>
		<constructionDuration>300000</constructionDuration>
		<statModifiers>
			<li><stat>RTD_Power_ProductionAdditive</stat><value>2</value></li>
		</statModifiers>
		<upkeep>130</upkeep>
		<postRework>true</postRework>
		<iconPath>GUI/Buildings/Orbital/orbitalSolarArray</iconPath>
	</FactionColonies.BuildingFCDef>

