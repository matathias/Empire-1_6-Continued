<?xml version="1.0" encoding="utf-8"?>
<!-- Example per-mutator resource bonuses. Attaches TileMutatorResourceExtension to
     vanilla mutators so settlements founded on those tiles get per-resource modifiers. -->
<Patch>

  <!-- Oasis: strong food bonus, minor medicine (herbal) bonus -->
  <Operation Class="PatchOperationConditional" MayRequire="Ludeon.RimWorld.Odyssey">
    <xpath>Defs/TileMutatorDef[defName="Oasis"]</xpath>
    <match Class="PatchOperationAdd">
      <xpath>Defs/TileMutatorDef[defName="Oasis"]</xpath>
      <value>
        <modExtensions>
          <li Class="FactionColonies.TileMutatorResourceExtension">
            <bonuses>
              <li>
                <resource>RTD_Food</resource>
                <multiplier>1.3</multiplier>
              </li>
              <li>
                <resource>RTD_Medicine</resource>
                <multiplier>1.15</multiplier>
              </li>
            </bonuses>
          </li>
        </modExtensions>
      </value>
    </match>
  </Operation>

  <!-- Wetland: food penalty, logging penalty, medicine (herbal) bonus -->
  <Operation Class="PatchOperationConditional" MayRequire="Ludeon.RimWorld.Odyssey">
    <xpath>Defs/TileMutatorDef[defName="Wetland"]</xpath>
    <match Class="PatchOperationAdd">
      <xpath>Defs/TileMutatorDef[defName="Wetland"]</xpath>
      <value>
        <modExtensions>
          <li Class="FactionColonies.TileMutatorResourceExtension">
            <bonuses>
              <li>
                <resource>RTD_Food</resource>
                <multiplier>0.85</multiplier>
              </li>
              <li>
                <resource>RTD_Logging</resource>
                <multiplier>0.9</multiplier>
              </li>
              <li>
                <resource>RTD_Medicine</resource>
                <multiplier>1.2</multiplier>
              </li>
            </bonuses>
          </li>
        </modExtensions>
      </value>
    </match>
  </Operation>

  <!-- Valley: broad production bonus from sheltered terrain -->
  <Operation Class="PatchOperationConditional" MayRequire="Ludeon.RimWorld.Odyssey">
    <xpath>Defs/TileMutatorDef[defName="Valley"]</xpath>
    <match Class="PatchOperationAdd">
      <xpath>Defs/TileMutatorDef[defName="Valley"]</xpath>
      <value>
        <modExtensions>
          <li Class="FactionColonies.TileMutatorResourceExtension">
            <bonuses>
              <li>
                <resource>RTD_Food</resource>
                <multiplier>1.1</multiplier>
              </li>
              <li>
                <resource>RTD_Logging</resource>
                <multiplier>1.1</multiplier>
              </li>
              <li>
                <resource>RTD_Mining</resource>
                <multiplier>1.1</multiplier>
              </li>
            </bonuses>
          </li>
        </modExtensions>
      </value>
    </match>
  </Operation>

  <!-- ToxicLake: severe food and medicine penalty -->
  <Operation Class="PatchOperationConditional" MayRequire="Ludeon.RimWorld.Odyssey">
    <xpath>Defs/TileMutatorDef[defName="ToxicLake"]</xpath>
    <match Class="PatchOperationAdd">
      <xpath>Defs/TileMutatorDef[defName="ToxicLake"]</xpath>
      <value>
        <modExtensions>
          <li Class="FactionColonies.TileMutatorResourceExtension">
            <bonuses>
              <li>
                <resource>RTD_Food</resource>
                <multiplier>0.5</multiplier>
              </li>
              <li>
                <resource>RTD_Medicine</resource>
                <multiplier>0.6</multiplier>
              </li>
              <li>
                <resource>RTD_Animals</resource>
                <multiplier>0.5</multiplier>
              </li>
            </bonuses>
          </li>
        </modExtensions>
      </value>
    </match>
  </Operation>

  <!-- Cliffs: mining bonus, food penalty -->
  <Operation Class="PatchOperationConditional" MayRequire="Ludeon.RimWorld.Odyssey">
    <xpath>Defs/TileMutatorDef[defName="Cliffs"]</xpath>
    <match Class="PatchOperationAdd">
      <xpath>Defs/TileMutatorDef[defName="Cliffs"]</xpath>
      <value>
        <modExtensions>
          <li Class="FactionColonies.TileMutatorResourceExtension">
            <bonuses>
              <li>
                <resource>RTD_Mining</resource>
                <multiplier>1.2</multiplier>
              </li>
              <li>
                <resource>RTD_Food</resource>
                <multiplier>0.9</multiplier>
              </li>
            </bonuses>
          </li>
        </modExtensions>
      </value>
    </match>
  </Operation>

</Patch>
