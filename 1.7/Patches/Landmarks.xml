<?xml version="1.0" encoding="utf-8"?>
<!-- Per-landmark resource bonuses. Attaches TileLandmarkResourceExtension to Odyssey
     LandmarkDefs so settlements founded on those tiles get per-resource modifiers. -->
<Patch>

  <Operation Class="PatchOperationConditional" MayRequire="Ludeon.RimWorld.Odyssey">
    <xpath>Defs/LandmarkDef[defName="Ruins"]</xpath>
    <match Class="PatchOperationAdd">
      <xpath>Defs/LandmarkDef[defName="Ruins"]</xpath>
      <value>
        <modExtensions>
          <li Class="FactionColonies.TileLandmarkResourceExtension">
            <bonuses>
              <li><resource>RTD_Mining</resource><multiplier>1.1</multiplier></li>
              <li><resource>RTD_Research</resource><multiplier>1.15</multiplier></li>
              <li><resource>RTD_Food</resource><multiplier>0.9</multiplier></li>
            </bonuses>
          </li>
        </modExtensions>
      </value>
    </match>
  </Operation>

