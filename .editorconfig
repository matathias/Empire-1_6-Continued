root = true

[*.cs]
indent_style = space
indent_size = 4

#-*-*-*-*-*-*-*-*-*-*-*-*-*-*-*-*-*-*-*-*-*-*-*-*-*-*-*-*-*-*-*-*-*-*-*-*-*-*-*-*-*
# Code style preferences (C# 14 / .NET 10). Kept at "suggestion" so they surface in
# the editor without affecting the build. The existing code has been converted
# to this style, so new code should follow it.
#-*-*-*-*-*-*-*-*-*-*-*-*-*-*-*-*-*-*-*-*-*-*-*-*-*-*-*-*-*-*-*-*-*-*-*-*-*-*-*-*-*

# IDE0161: file-scoped namespaces
csharp_style_namespace_declarations = file_scoped:suggestion
dotnet_diagnostic.IDE0161.severity = suggestion

# IDE0083: "x is not T" instead of "!(x is T)"
csharp_style_prefer_not_pattern = true:suggestion
dotnet_diagnostic.IDE0083.severity = suggestion

# IDE0041: "is null" instead of ReferenceEquals / (object)x == null
dotnet_style_prefer_is_null_check_over_reference_equality_method = true:suggestion
dotnet_diagnostic.IDE0041.severity = suggestion

# IDE0074: "x ??= y"
dotnet_style_prefer_compound_assignment = true:suggestion
dotnet_diagnostic.IDE0074.severity = suggestion

# IDE0090: target-typed "new()" when the type is apparent
csharp_style_implicit_object_creation_when_type_is_apparent = true:suggestion
dotnet_diagnostic.IDE0090.severity = suggestion

# IDE0028 / IDE0300-IDE0304: collection initializers and collection expressions ("[]")
dotnet_style_collection_initializer = true:suggestion
dotnet_style_prefer_collection_expression = when_types_loosely_match:suggestion
dotnet_diagnostic.IDE0028.severity = suggestion
dotnet_diagnostic.IDE0300.severity = suggestion
dotnet_diagnostic.IDE0301.severity = suggestion
dotnet_diagnostic.IDE0302.severity = suggestion
dotnet_diagnostic.IDE0303.severity = suggestion
dotnet_diagnostic.IDE0304.severity = suggestion
# IDE0305 (".ToList()" -> "[.. query]") is off: the spread form hides the end of long LINQ chains
dotnet_diagnostic.IDE0305.severity = none

# IDE0066: switch expressions (applied selectively; review before accepting)
csharp_style_prefer_switch_expression = true:suggestion
dotnet_diagnostic.IDE0066.severity = suggestion
