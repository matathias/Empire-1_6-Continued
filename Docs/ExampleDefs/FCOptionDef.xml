<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- This file shows all options for FCOptionDef, and explains what they do and their default values -->
  <!-- FCOptionDefs define player choices that appear during certain events. -->
  <!-- When an event has options, a window is shown with each option as a clickable card. -->
  <!-- Each option has a success chance, optional silver cost, and references to success/fail follow-up events. -->
  <FactionColonies.FCOptionDef>
	<defName>exampleOption</defName>
	<label>Option display text shown to the player</label>
	<!-- Base chance of success (0-100). The UI shows descriptive labels:
	     100+  = "Guaranteed"
	     75-99 = "Likely"
	     40-74 = "Uncertain"
	     0-39  = "Risky" -->
	<baseChanceOfSuccess>75</baseChanceOfSuccess>
	<!-- Silver cost to choose this option. 0 or less = free. Default: 0 -->
	<silverCost>0</silverCost>
	<!-- The event that this option belongs to. -->
	<parentEvent>exampleEvent</parentEvent>
	<!-- The event that fires if the player succeeds. If null, nothing happens on success. Default: null -->
	<successEvent>exampleEventSuccess</successEvent>
	<!-- The event that fires if the player fails. If null, nothing happens on failure. Default: null -->
	<failEvent>exampleEventFail</failEvent>
	<!-- *=*=* Policy Requirements *=*=* -->
	<!-- Policies that must be active for this option to be available. If empty, always available. -->
	<requiredPolicies>
		<li>examplePolicy</li>
	</requiredPolicies>
	<!-- Whether all or any of the required policies must be active. Valid values: All, Any. Default: All -->
	<requirementMode>All</requirementMode>
	<!-- *=*=* Ideology Meme Requirements (optional) *=*=* -->
	<!-- MemeDef defNames the empire's primary ideoligion must have for this option to appear. Stored as -->
	<!-- raw strings (not MemeDef references) so meme-gated options load without errors when Ideology is off. -->
	<!-- When Ideology is disabled, any option with a meme gate is hidden entirely (unlike policy gates, -->
	<!-- which grey out unmet options). If empty, no meme requirement. -->
	<requiredMemes>
		<!-- <li>Raider</li> -->
	</requiredMemes>
	<!-- Whether all or any of the required memes must be present. Valid values: All, Any. Default: All -->
	<memeRequirementMode>All</memeRequirementMode>
  </FactionColonies.FCOptionDef>

</Defs>
