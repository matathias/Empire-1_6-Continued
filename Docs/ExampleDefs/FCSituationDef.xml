<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- This file shows all options for the Situations feature and explains what they do. -->
  <!-- A Situation is a long-lived, bidirectional progress meter that advances/recedes over time,    -->
  <!-- crossing authored stage thresholds (which apply stat-modifiers and fire events) and resolving, -->
  <!-- holding, or looping at its endpoints. The player steers it by picking one active approach.     -->
  <!--                                                                                                 -->
  <!-- Every effect a Situation produces is delegated to the existing event system: stage/endpoint    -->
  <!-- slots fire FCEventDefs. Author those events as normal FCEventDefs (see FCEventDef.xml).         -->

  <!-- =============================== STAGE DEFS =============================== -->
  <!-- Stages are their own Defs, referenced by defName from the situation's <stages> list.           -->
  <!-- The current stage is the highest stage whose threshold <= the bar's progress.                  -->

  <FactionColonies.FCSituationStageDef>
    <defName>ExampleCrisis_Murmurs</defName>
    <label>murmurs</label>
    <!-- Entry point on the bar; stages must be ordered ascending and within [0, maxProgress]. -->
    <threshold>25</threshold>
    <!-- Applied whenever the bar is in this stage (position-based: in-stage == applied). -->
    <statModifiers>
      <li><stat>taxRate</stat><value>-0.1</value></li>
    </statModifiers>
    <!-- Direction-aware event slots (all optional FCEventDefs). A boundary crossing belongs to        -->
    <!-- whichever stage conceptually owns it; do not populate both sides unless two events are wanted. -->
    <onEnterFromBelow>ExampleCrisis_MurmursLetter</onEnterFromBelow>
    <!-- <onEnterFromAbove/> <onExitUpward/> <onExitDownward/> -->
    <!-- When true, each slot fires at most once for a given situation instance (latched). -->
    <fireEventsOnce>true</fireEventsOnce>
  </FactionColonies.FCSituationStageDef>

  <FactionColonies.FCSituationStageDef>
    <defName>ExampleCrisis_Serious</defName>
    <label>serious unrest</label>
    <threshold>50</threshold>
    <statModifiers>
      <li><stat>taxRate</stat><value>-0.5</value></li>
    </statModifiers>
    <onEnterFromBelow>ExampleCrisis_ReferendumEvent</onEnterFromBelow>
    <fireEventsOnce>true</fireEventsOnce>
  </FactionColonies.FCSituationStageDef>

  <FactionColonies.FCSituationStageDef>
    <defName>ExampleCrisis_Breaking</defName>
    <label>breaking point</label>
    <threshold>75</threshold>
  </FactionColonies.FCSituationStageDef>

  <!-- ============================= APPROACH DEFS ============================= -->
  <!-- Approaches are their own Defs, referenced by defName from the situation's <approaches> list.    -->
  <!-- Exactly one is active at a time; switching is free + immediate.                                 -->

  <FactionColonies.FCSituationApproachDef>
    <!-- The default/baseline approach: must be a member of <approaches>, free, and ungated. -->
    <defName>ExampleCrisis_Observe</defName>
    <label>observe</label>
    <description>Let the situation run its course.</description>
    <!-- Signed addend on the bar's daily delta. The sign is authored here and added unconditionally    -->
    <!-- (NOT reoriented to advance/recede): a positive value pushes the bar up even while the base     -->
    <!-- rate recedes it. Author the sign to express what the stance does.                              -->
    <ratePerDay>0</ratePerDay>
    <upkeepSilver>0</upkeepSilver>
  </FactionColonies.FCSituationApproachDef>

  <FactionColonies.FCSituationApproachDef>
    <defName>ExampleCrisis_Concessions</defName>
    <label>concessions</label>
    <description>Buy calm with silver and softened policy. Pulls the crisis bar down.</description>
    <ratePerDay>-2</ratePerDay>
    <!-- Silver charged per day while active (v1 upkeep is silver only). If it can't be                 -->
    <!-- paid, the situation auto-reverts to its defaultApproach and notifies the player.               -->
    <upkeepSilver>50</upkeepSilver>
    <statModifiers>
      <li><stat>happinessGainedBase</stat><value>1</value></li>
    </statModifiers>
    <!-- Gating (optional). requiredPolicies + requirementMode reuse the FCOptionDef gating shape.      -->
    <!-- requiredResearch is declared directly here (it is NOT an FCOptionDef field).                   -->
    <!-- <requiredPolicies><li>SomePolicyDef</li></requiredPolicies> -->
    <!-- <requirementMode>All</requirementMode>  (All | Any) -->
    <!-- <requiredResearch><li>SomeResearchProjectDef</li></requiredResearch> -->
  </FactionColonies.FCSituationApproachDef>

  <FactionColonies.FCSituationApproachDef>
    <defName>ExampleCrisis_Crackdown</defName>
    <label>crackdown</label>
    <description>Garrison the streets. Drives the crisis bar up but suppresses overt unrest.</description>
    <ratePerDay>2</ratePerDay>
    <upkeepSilver>80</upkeepSilver>
    <statModifiers>
      <li><stat>unrestGainedBase</stat><value>-2</value></li>
    </statModifiers>
  </FactionColonies.FCSituationApproachDef>

  <!-- ============================== SITUATION DEF ============================== -->

  <FactionColonies.FCSituationDef>
    <defName>ExampleCrisis</defName>
    <label>civil crisis</label>
    <description>Discontent is mounting in this settlement. Left unchecked it will boil over.</description>
    <!-- Reuses FCEventCategoryDef for accent color + display order. -->
    <category>EC_Social</category>
    <!-- <iconPath>UI/SomeIcon</iconPath> -->

    <!-- Faction | Settlement. Settlement-scoped situations carry a target settlement. -->
    <scope>Settlement</scope>

    <maxProgress>100</maxProgress>
    <startProgress>0</startProgress>

    <!-- Advance rate: used while the condition's ShouldAdvance is true (or always, if no condition). -->
    <baseRatePerDay>5</baseRatePerDay>
    <!-- Recede rate (conventionally negative): used while ShouldAdvance is false.                     -->
    <!-- Ignored for condition-less pure timers (those always advance).                               -->
    <decayRatePerDay>-3</decayRatePerDay>

    <!-- Stages and approaches referenced by defName. -->
    <stages>
      <li>ExampleCrisis_Murmurs</li>
      <li>ExampleCrisis_Serious</li>
      <li>ExampleCrisis_Breaking</li>
    </stages>
    <approaches>
      <li>ExampleCrisis_Observe</li>
      <li>ExampleCrisis_Concessions</li>
      <li>ExampleCrisis_Crackdown</li>
    </approaches>
    <!-- Explicit baseline/fallback (the upkeep auto-revert target). Must be a free, ungated member of approaches. -->
    <defaultApproach>ExampleCrisis_Observe</defaultApproach>

    <!-- Per-end behavior: Terminal (fire resolution event then remove) | Clamp (hold) | Loop (wrap).  -->
    <topBehavior>Terminal</topBehavior>
    <bottomBehavior>Terminal</bottomBehavior>
    <topResolutionEvent>ExampleCrisis_SecessionEvent</topResolutionEvent>
    <bottomResolutionEvent>ExampleCrisis_CalmedEvent</bottomResolutionEvent>
    <!-- <loopEvent>SomeRecurringEvent</loopEvent>  (required if either endpoint is Loop) -->

    <!-- Spawn eligibility / uniqueness. cooldownDays is keyed per (def, target). maxConcurrent is the -->
    <!-- per-target cap. -->
    <cooldownDays>15</cooldownDays>
    <maxConcurrent>1</maxConcurrent>

    <!-- While any active blocking situation targets a settlement, the player cannot delete it. Only    -->
    <!-- meaningful on a Settlement-scoped def. The handler extension can override this dynamically.     -->
    <blocksSettlementRemoval>false</blocksSettlementRemoval>
    <!-- <removalBlockedReasonKey>FCSituationSomeReason</removalBlockedReasonKey> -->

    <!-- A condition and/or a handler are attached via modExtensions (both optional). -->
    <modExtensions>
      <!-- Built-in social condition over the four social stats. spawnWhen drives ShouldSpawn;          -->
      <!-- advanceWhen drives ShouldAdvance (defaults to spawnWhen when omitted, giving hysteresis when -->
      <!-- it differs). Each clause: stat in {Loyalty,Unrest,Happiness,Prosperity}, comparison          -->
      <!-- Below/Above, and a threshold. Sets are combined All/Any.                                     -->
      <li Class="FactionColonies.FCSituationSocialSettlementCondition">
        <spawnWhen>
          <mode>All</mode>
          <clauses>
            <li><stat>Loyalty</stat><comparison>Below</comparison><threshold>30</threshold></li>
            <li><stat>Unrest</stat><comparison>Above</comparison><threshold>70</threshold></li>
          </clauses>
        </spawnWhen>
        <advanceWhen>
          <mode>All</mode>
          <clauses>
            <li><stat>Unrest</stat><comparison>Above</comparison><threshold>50</threshold></li>
          </clauses>
        </advanceWhen>
      </li>
      <!-- Optional code hooks (subclass FCSituationHandlerExtension in C# and attach it here):          -->
      <!-- OnStarted / OnStageChanged / OnProgressTick / OnResolved / OnLooped, approach availability    -->
      <!-- and label overrides, BlocksSettlementRemoval, and GetCustomActions (settlement-panel buttons).-->
      <!-- <li Class="YourMod.YourSituationHandler"/> -->
    </modExtensions>
  </FactionColonies.FCSituationDef>

  <!-- ===================== START A SITUATION FROM AN EVENT ===================== -->
  <!-- Attach FCEventHandlerExtension_StartSituation to any FCEventDef / FCOptionDef outcome to start    -->
  <!-- (and optionally first resolve) a situation when that event fires. The target is the event's first -->
  <!-- settlement, or none for a faction-scoped situation. situationToResolve enables cross-situation     -->
  <!-- transitions (end a crisis, begin an autonomy situation on the same settlement).                    -->
  <!--                                                                                                    -->
  <!-- <FactionColonies.FCEventDef>                                                                       -->
  <!--   <defName>ExampleStartSituationEvent</defName>                                                    -->
  <!--   ... usual event fields ...                                                                       -->
  <!--   <modExtensions>                                                                                  -->
  <!--     <li Class="FactionColonies.FCEventHandlerExtension_StartSituation">                            -->
  <!--       <situationToStart>ExampleAutonomy</situationToStart>                                         -->
  <!--       <situationToResolve>ExampleCrisis</situationToResolve>                                       -->
  <!--     </li>                                                                                          -->
  <!--   </modExtensions>                                                                                 -->
  <!-- </FactionColonies.FCEventDef>                                                                      -->

</Defs>
