<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- This file shows all options for MilitaryJobDef, and explains what they do and their default values -->
  <!-- MilitaryJobDefs define military actions that squads can perform (e.g. raid, enslave, capture, defend). -->
  <!-- Each job has a handler class that implements the actual behavior, and configuration for how it -->
  <!-- appears in menus, whether it occupies a target, and whether it is enabled by default. -->
  <FactionColonies.MilitaryJobDef>
	<defName>exampleMilitaryJob</defName>
	<label>Example Military Job</label>
	<description>A brief description of this military job.</description>
	<!-- The C# class that implements this job's behavior. Must be a subclass of MilitaryJobHandler. -->
	<!-- The handler is instantiated once per def and cached. -->
	<handlerClass>YourNamespace.YourMilitaryJobHandler</handlerClass>
	<!-- Translation key for the status label shown while this job is active (e.g. "Raiding", "Defending"). -->
	<statusLabelKey>FCMilJob_Example_Status</statusLabelKey>
	<!-- Translation key for the label shown in the float menu when selecting this job. -->
	<floatMenuLabelKey>FCMilJob_Example_Label</floatMenuLabelKey>
	<!-- Translation key for the description tooltip shown in the float menu. -->
	<floatMenuDescKey>FCMilJob_Example_Desc</floatMenuDescKey>
	<!-- Per-job rewards summary shown in the Squad Source Picker right column, prefixed -->
	<!-- with "Rewards: ". Translatable via DefInjections (no separate key needed). Optional. -->
	<rewardsDesc>A short prose summary of what the player gets when this operation succeeds.</rewardsDesc>
	<!-- If true, the target settlement/location is "occupied" while this job is active, -->
	<!-- preventing other jobs from targeting the same location. Default: true -->
	<occupiesTarget>true</occupiesTarget>
	<!-- If true, this job represents a persistent state rather than a one-time action. Default: false -->
	<isState>false</isState>
	<!-- If true, this job is enabled by default (can be blocked by FCPolicyDef.blockedMilitaryJobs). -->
	<!-- If false, it must be explicitly enabled by FCPolicyDef.enabledMilitaryJobs. Default: true -->
	<defaultEnabled>true</defaultEnabled>
  </FactionColonies.MilitaryJobDef>

</Defs>
