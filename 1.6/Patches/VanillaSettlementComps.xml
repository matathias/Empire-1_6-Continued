<?xml version="1.0" encoding="utf-8"?>
<!-- Injects Empire interaction gizmos (attack, diplomacy) onto vanilla settlements
     via WorldObjectComp instead of Harmony patching Settlement.GetGizmos(). -->
<Patch>
  <Operation Class="PatchOperationAdd">
    <xpath>Defs/WorldObjectDef[defName="Settlement"]/comps</xpath>
    <value>
      <li Class="FactionColonies.WorldObjectCompProperties_FactionInteraction" />
      <!-- Withdraw / watch-battle controls during an Empire manual offensive battle. Inert on
           every settlement without an active offense battlefield (and on Empire's own settlements). -->
      <li Class="FactionColonies.WorldObjectCompProperties_OffenseControls" />
    </value>
  </Operation>
</Patch>
