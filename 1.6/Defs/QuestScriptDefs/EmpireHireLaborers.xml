<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <!-- =========================================================================================
       "Hire Laborers" quests. The Empire sends a small group of temporary, general-labor-only
       colonists that the player controls, then sends them home after a set number of days.
       Fired from LaborerHireUtil.HireLaborers with slate:
         map, laborersCount, permitFaction, laborersPawnKind, laborersDurationDays, laborerSkillBonus,
         arrivalMode (ground only) / landingCell (shuttle only).
       Both variants are gated behind Royalty (a deliberate design choice). No goodwill nodes: the
       Empire's goodwill mirrors average settlement happiness and is re-synced daily, so a direct
       quest goodwill change would be undone the next day. A laborer's death is instead penalized as a
       settlement-happiness loss by the Pawn.Kill patch (see PawnPatches + EmpireDeathPenaltyUtil).
       ========================================================================================= -->

  <!-- Ground variant: edge walk-in or center drop, walk off the edge on contract end. -->
  <QuestScriptDef MayRequire="Ludeon.RimWorld.Royalty">
    <defName>Empire_HireLaborers_Ground</defName>
    <isRootSpecial>true</isRootSpecial>
    <autoAccept>true</autoAccept>
    <defaultHidden>true</defaultHidden>
    <questDescriptionAndNameRules>
      <rulesStrings>
        <li>questName->Laborers</li>
        <li>questDescription-></li>
      </rulesStrings>
    </questDescriptionAndNameRules>
    <root Class="QuestNode_Sequence">
      <nodes>

        <!-- Generate laborers -->
        <li Class="QuestNode_LoopCount">
          <loopCount>$laborersCount</loopCount>
          <node Class="QuestNode_GeneratePawn">
            <kindDef>$laborersPawnKind</kindDef>
            <faction>$permitFaction</faction>
            <addToList>laborers</addToList>
            <allowAddictions>false</allowAddictions>
            <allowPregnant>false</allowPregnant>
          </node>
        </li>
        <!-- Scale competence with average settlement level (no-op when the bonus is 0) -->
        <li Class="QuestNode_BoostLaborerSkills">
          <pawns>$laborers</pawns>
          <skillBonus>$laborerSkillBonus</skillBonus>
        </li>
        <!-- Lock their apparel so they leave with what they came in -->
        <li Class="QuestNode_SetAllApparelLocked">
          <pawns>$laborers</pawns>
        </li>
        <!-- Disable all work except general labor -->
        <li Class="QuestNode_WorkDisabled">
          <pawns>$laborers</pawns>
          <disabledWorkTags>
            <li>Violent</li>
            <li>Social</li>
            <li>Intellectual</li>
            <li>Animals</li>
          </disabledWorkTags>
        </li>
        <!-- On-duty mood buff -->
        <li Class="QuestNode_AddMemoryThought">
          <pawns>$laborers</pawns>
          <def>OnDuty</def>
        </li>
        <!-- Remember the Empire as home faction so they revert to it when they leave -->
        <li Class="QuestNode_ExtraFaction">
          <faction>$permitFaction</faction>
          <pawns>$laborers</pawns>
          <factionType>HomeFaction</factionType>
        </li>
        <!-- Any quest end (timer, hostility) walks them off the edge and back to the Empire -->
        <li Class="QuestNode_LeaveOnCleanup">
          <pawns>$laborers</pawns>
          <sendStandardLetter>false</sendStandardLetter>
        </li>

        <!-- Arrival: edge walk-in or center drop, chosen by the mod via the arrivalMode slate.
             joinPlayer flips them to controllable player colonists at the moment they spawn. -->
        <li Class="QuestNode_PawnsArrive">
          <pawns>$laborers</pawns>
          <arrivalMode>$arrivalMode</arrivalMode>
          <joinPlayer>true</joinPlayer>
        </li>
        <li Class="QuestNode_Letter">
          <label TKey="LetterLabelEmpireLaborersArrived">Laborers arrived</label>
          <text TKey="LetterTextEmpireLaborersArrived">Laborers sent by [permitFaction_name] have arrived to help out. They will head home in [laborersDurationDays] days.</text>
          <lookTargets>$laborers</lookTargets>
          <filterDeadPawnsFromLookTargets>True</filterDeadPawnsFromLookTargets>
        </li>

        <!-- Contract timer: notify and end the quest; LeaveOnCleanup sends them home -->
        <li Class="QuestNode_Delay">
          <delayTicks>$($laborersDurationDays * 60000)</delayTicks>
          <node Class="QuestNode_Sequence">
            <nodes>
              <li Class="QuestNode_Letter">
                <label TKey="LetterLabelEmpireLaborersLeaving">Laborers leaving</label>
                <text TKey="LetterTextEmpireLaborersLeaving">The laborers from [permitFaction_name] have finished their contract and are heading home.</text>
                <lookTargets>$laborers</lookTargets>
                <filterDeadPawnsFromLookTargets>True</filterDeadPawnsFromLookTargets>
              </li>
              <li Class="QuestNode_End" />
            </nodes>
          </node>
        </li>

        <!-- End the quest if the Empire turns hostile -->
        <li Class="QuestNode_Signal">
          <inSignal>permitFaction.BecameHostileToPlayer</inSignal>
          <node Class="QuestNode_End" />
        </li>

      </nodes>
    </root>
  </QuestScriptDef>

  <!-- Shuttle variant: laborers shuttle in and a shuttle collects them on contract end. -->
  <QuestScriptDef MayRequire="Ludeon.RimWorld.Royalty">
    <defName>Empire_HireLaborers_Shuttle</defName>
    <isRootSpecial>true</isRootSpecial>
    <autoAccept>true</autoAccept>
    <defaultHidden>true</defaultHidden>
    <questDescriptionAndNameRules>
      <rulesStrings>
        <li>questName->Laborers</li>
        <li>questDescription-></li>
      </rulesStrings>
    </questDescriptionAndNameRules>
    <root Class="QuestNode_Sequence">
      <nodes>

        <!-- Generate laborers -->
        <li Class="QuestNode_LoopCount">
          <loopCount>$laborersCount</loopCount>
          <node Class="QuestNode_GeneratePawn">
            <kindDef>$laborersPawnKind</kindDef>
            <faction>$permitFaction</faction>
            <addToList>laborers</addToList>
            <allowAddictions>false</allowAddictions>
            <allowPregnant>false</allowPregnant>
          </node>
        </li>
        <li Class="QuestNode_BoostLaborerSkills">
          <pawns>$laborers</pawns>
          <skillBonus>$laborerSkillBonus</skillBonus>
        </li>
        <li Class="QuestNode_SetAllApparelLocked">
          <pawns>$laborers</pawns>
        </li>
        <li Class="QuestNode_WorkDisabled">
          <pawns>$laborers</pawns>
          <disabledWorkTags>
            <li>Violent</li>
            <li>Social</li>
            <li>Intellectual</li>
            <li>Animals</li>
          </disabledWorkTags>
        </li>
        <li Class="QuestNode_AddMemoryThought">
          <pawns>$laborers</pawns>
          <def>OnDuty</def>
        </li>
        <li Class="QuestNode_ExtraFaction">
          <faction>$permitFaction</faction>
          <pawns>$laborers</pawns>
          <factionType>HomeFaction</factionType>
        </li>
        <li Class="QuestNode_JoinPlayer">
          <pawns>$laborers</pawns>
          <joinPlayer>True</joinPlayer>
          <makePrisoners>False</makePrisoners>
        </li>
        <li Class="QuestNode_LeaveOnCleanup">
          <pawns>$laborers</pawns>
          <sendStandardLetter>false</sendStandardLetter>
        </li>

        <!-- Laborers arrive by shuttle -->
        <li Class="QuestNode_SubScript">
          <def>Util_TransportShip_DropOff</def>
          <parms>
            <contents>$laborers</contents>
            <owningFaction>$permitFaction</owningFaction>
          </parms>
        </li>
        <li Class="QuestNode_Letter">
          <label TKey="LetterLabelEmpireLaborersArrived">Laborers arrived</label>
          <text TKey="LetterTextEmpireLaborersArrivedShuttle">Laborers sent by [permitFaction_name] have arrived to help out. A shuttle will collect them in [laborersDurationDays] days.</text>
          <lookTargets>$laborers</lookTargets>
          <filterDeadPawnsFromLookTargets>True</filterDeadPawnsFromLookTargets>
        </li>

        <!-- Departure shuttle after the contract -->
        <li Class="QuestNode_ShuttleDelay">
          <delayTicks>$($laborersDurationDays * 60000)</delayTicks>
          <lodgers>$laborers</lodgers>
          <node Class="QuestNode_Sequence">
            <nodes>
              <li Class="QuestNode_SubScript">
                <def>Util_TransportShip_Pickup</def>
                <parms>
                  <leaveDelayTicks>$(1*60000)</leaveDelayTicks>
                  <requiredPawns>$laborers</requiredPawns>
                </parms>
              </li>
              <li Class="QuestNode_Letter">
                <label TKey="LetterLabelEmpireLaborersShuttleArrived">Shuttle arrived</label>
                <text TKey="LetterTextEmpireLaborersShuttleArrived">A shuttle has arrived to collect the laborers from [permitFaction_name].</text>
                <lookTargets>$pickupShipThing</lookTargets>
              </li>
            </nodes>
          </node>
        </li>

        <!-- Quest-flow ends (no goodwill consequences) -->
        <li Class="QuestNode_Signal">
          <inSignal>laborers.LeftBehind</inSignal>
          <node Class="QuestNode_End" />
        </li>
        <li Class="QuestNode_Signal">
          <inSignal>pickupShipThing.LeftBehind</inSignal>
          <node Class="QuestNode_End" />
        </li>
        <li Class="QuestNode_Signal">
          <inSignal>pickupShipThing.Destroyed</inSignal>
          <node Class="QuestNode_End" />
        </li>
        <li Class="QuestNode_Signal">
          <inSignal>pickupShipThing.SentUnsatisfied</inSignal>
          <node Class="QuestNode_End" />
        </li>
        <li Class="QuestNode_Signal">
          <inSignal>pickupShipThing.SentSatisfied</inSignal>
          <node Class="QuestNode_End" />
        </li>

        <!-- End if the Empire turns hostile -->
        <li Class="QuestNode_Signal">
          <inSignal>permitFaction.BecameHostileToPlayer</inSignal>
          <node Class="QuestNode_End" />
        </li>

      </nodes>
    </root>
  </QuestScriptDef>

</Defs>
