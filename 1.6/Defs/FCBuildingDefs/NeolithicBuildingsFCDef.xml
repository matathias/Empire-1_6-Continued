		<cost>225</cost>
		<constructionDuration>45000</constructionDuration> <!-- Ticks it takes until construction is finished -->
		<statModifiers>
			<li><stat>RTD_Apparel_ProductionMultiplier</stat><value>1.15</value></li>
			<li><stat>RTD_Animals_ProductionMultiplier</stat><value>0.85</value></li>
		</statModifiers>
		<applicableBiomes> <!-- If the building requires it to be in a biome, put it here-->
			<li>BorealForest</li>
			<li>TemperateForest</li>
			<li>TropicalRainforest</li>
			<li>TemperateGuldenForest</li>
		</applicableBiomes>
		<upkeep></upkeep> <!-- cost per week for the building -->
		<postRework>true</postRework>
		<iconPath>GUI/Buildings/furrier</iconPath>
