		<cost>175</cost>
		<constructionDuration>40000</constructionDuration> <!-- Ticks it takes until construction is finished -->
		<statModifiers>
			<li><stat>RTD_Weapons_ProductionMultiplier</stat><value>1.15</value></li>
			<li><stat>RTD_Animals_ProductionMultiplier</stat><value>0.85</value></li>
		</statModifiers>
		<upkeep></upkeep> <!-- cost per week for the building -->
		<postRework>true</postRework>
		<iconPath>GUI/Buildings/fletcher</iconPath>
	</FactionColonies.BuildingFCDef>

	<!-- Stone Mason -->
	<FactionColonies.BuildingFCDef ParentName="BuildingFCDef_Surface_Neolithic">
		<defName>stoneMason</defName> <!--Name of Def -->
		<label>Stone Mason</label> <!--Lable of Def -->
