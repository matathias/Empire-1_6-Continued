<?xml version="1.0" encoding="utf-8" ?>
<Defs>

<!--  NEOLITHIC TIER   -->

    <!-- Cereal Farmland -->
	<FactionColonies.BuildingFCDef ParentName="BuildingFCDef_Surface_Neolithic">
		<defName>cerealFarmland</defName> <!--Name of Def -->
		<label>Cereal Farmland</label> <!--Lable of Def -->
		<desc>Land for growing cereal crops to feed more than a single village.</desc> <!-- Description of trait -->
		<cost>250</cost>
		<constructionDuration>60000</constructionDuration> <!-- Ticks it takes until construction is finished -->
		<statModifiers>
			<li><stat>workerBaseMax</stat><value>-2</value></li>
			<li><stat>RTD_Food_ProductionAdditive</stat><value>0.2</value></li>
		</statModifiers>
		<maxhilliness>Flat</maxhilliness>
		<upkeep>0</upkeep> <!-- cost per week for the building -->
		<postRework>true</postRework>
		<iconPath>GUI/Buildings/cerealFarmland</iconPath>
	</FactionColonies.BuildingFCDef>

	<!-- Grain Mill -->
	<FactionColonies.BuildingFCDef ParentName="BuildingFCDef_Surface_Neolithic">
		<defName>grainMill</defName> <!--Name of Def -->
		<label>Grain Mill</label> <!--Lable of Def -->
		<desc>A mill to process cereal crops with big, grindy rocks.</desc> <!-- Description of trait -->
		<cost>300</cost>
		<constructionDuration>45000</constructionDuration> <!-- Ticks it takes until construction is finished -->
		<statModifiers>
			<li><stat>RTD_Food_ProductionMultiplier</stat><value>1.15</value></li>
		</statModifiers>
		<upkeep>5</upkeep> <!-- cost per week for the building -->
		<postRework>true</postRework>
		<iconPath>GUI/Buildings/grainMill</iconPath>
	</FactionColonies.BuildingFCDef>

	<!-- Granary -->
	<FactionColonies.BuildingFCDef ParentName="BuildingFCDef_Surface_Neolithic">
		<defName>granary</defName> <!--Name of Def -->
		<label>Granary</label> <!--Lable of Def -->
		<desc>A safe place to store cereal crops from those pesky rats.</desc> <!-- Description of trait -->
		<cost>150</cost>
		<constructionDuration>30000</constructionDuration> <!-- Ticks it takes until construction is finished -->
		<statModifiers>
			<li><stat>RTD_Food_ProductionMultiplier</stat><value>1.10</value></li>
		</statModifiers>
		<upkeep>15</upkeep> <!-- cost per week for the building -->
		<postRework>true</postRework>
		<iconPath>GUI/Buildings/granary</iconPath>
	</FactionColonies.BuildingFCDef>

	<!-- Fletcher -->
