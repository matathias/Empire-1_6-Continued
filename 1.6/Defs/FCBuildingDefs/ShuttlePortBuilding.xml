<?xml version="1.0" encoding="utf-8" ?>
<Defs>
	<FactionColonies.BuildingFCDef MayRequire="Ludeon.RimWorld.Royalty">
		<defName>shuttlePort</defName>
		<!--Name of Def -->
		<label>Shuttle Port</label>
		<!--Lable of Def -->
		<desc>A small scale airport, this building provides the infrastructure to rapidly send goods around the planet. This building allows you to send three shuttles every tax cycle.</desc>
		<!-- Description of trait -->
		<cost>4000</cost>
		<techLevel>Spacer</techLevel>
		<constructionDuration>300000</constructionDuration>
		<!-- Ticks it takes until construction is finished -->
		<statModifiers>
			<li><stat>taxBaseRandomModifier</stat><value>10</value></li>
			<li><stat>taxBasePercentage</stat><value>5</value></li>
		</statModifiers>
		<upkeep>120</upkeep>
		<postRework>true</postRework>
		<iconPath>GUI/Buildings/ShuttlePort</iconPath>
		<modExtensions>
		  <li Class="FactionColonies.BuildingFCExtension_Shuttles">
		    <compClass>FactionColonies.SettlementBuildingComp_Shuttles</compClass>
			<shuttleUses>3</shuttleUses>
		  </li>
		</modExtensions>
	</FactionColonies.BuildingFCDef>
</Defs>
