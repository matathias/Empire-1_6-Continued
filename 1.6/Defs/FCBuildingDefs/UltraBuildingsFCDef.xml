<?xml version="1.0" encoding="utf-8" ?>
<Defs>

	<FactionColonies.BuildingFCDef ParentName="BuildingFCDef_Surface_Ultra">
		<defName>LightConverter</defName>
		<!--Name of Def -->
		<label>Archotech Light Converter</label>
		<!--Lable of Def -->
		<desc>A large, vanometrically powered, archotech machine that can turn light into just about anything that isn't alive. Needs a constant military presence to ward off raiders.</desc>
		<!-- Description of trait -->
		<cost>120000</cost>
		<constructionDuration>600000</constructionDuration>
		<!-- Ticks it takes until construction is finished -->
		<statModifiers>
			<li><stat>militaryBaseLevel</stat><value>-3</value></li>
			<li><stat>RTD_Food_ProductionMultiplier</stat><value>1.75</value></li>
			<li><stat>RTD_Weapons_ProductionMultiplier</stat><value>1.75</value></li>
			<li><stat>RTD_Apparel_ProductionMultiplier</stat><value>1.75</value></li>
			<li><stat>RTD_Logging_ProductionMultiplier</stat><value>1.75</value></li>
			<li><stat>RTD_Mining_ProductionMultiplier</stat><value>1.75</value></li>
			<li><stat>RTD_Medicine_ProductionMultiplier</stat><value>1.75</value></li>
		</statModifiers>
		<upkeep>800</upkeep>
		<postRework>true</postRework>
		<!-- cost per week for the building -->
		<iconPath>GUI/Buildings/LightConverter</iconPath>
	</FactionColonies.BuildingFCDef>

