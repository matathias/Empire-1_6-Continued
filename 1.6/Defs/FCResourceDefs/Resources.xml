<?xml version="1.0" encoding="utf-8"?>
<Defs>
  
  <FactionColonies.ResourceTypeDef>
	<defName>RTD_Food</defName>
	<label>farming</label>
	<description>A resource category for farmed crops: food, textiles, and other non-food plant harvests.</description>
	<iconPath>GUI/ProductionFood</iconPath>
	<color>(0.45, 0.75, 0.35)</color>
	<uiPriority>100</uiPriority>
	<isDefaultResource>true</isDefaultResource>
	<productionAdditiveStat>RTD_Food_ProductionAdditive</productionAdditiveStat>
	<productionMultiplierStat>RTD_Food_ProductionMultiplier</productionMultiplierStat>
	<thingAllowList>
		<li>
			<thingDef>Hay</thingDef>
		</li>
		<li>
			<thingDef>Kibble</thingDef>
		</li>
		<!-- Beer is a drug by category but is a brewed agricultural product; it belongs to farming, not medicine -->
		<li>
			<thingDef>Beer</thingDef>
		</li>
	</thingAllowList>
	<thingCategoryAllowList>
		<li>
			<thingCategoryDef>Foods</thingCategoryDef>
		</li>
	</thingCategoryAllowList>
	<thingCategoryBlockList>
		<li>MeatRaw</li>
		<li>AnimalProductRaw</li>
	</thingCategoryBlockList>
	<thingBlockList>
		<!-- Hemogen packs are in the vanilla Foods category but belong to the medicine resource -->
		<li MayRequire="Ludeon.RimWorld.Biotech">HemogenPack</li>
	</thingBlockList>
	<associatedSkills>
		<li>Plants</li>
		<li>Cooking</li>
	</associatedSkills>
	<titheMinCount>1</titheMinCount>
	<titheMaxCountBase>5</titheMaxCountBase>
	<titheMaxCountScaler>1</titheMaxCountScaler>
	<modExtensions>
		<li Class="FactionColonies.ResourceProductionExtension_Hilliness">
			<extName>Hilliness</extName>
			<extDesc>Tile hilliness</extDesc>
			<resourceHilliness>
				<li>
					<hilliness>Flat</hilliness>
					<multiplier>1.1</multiplier>
				</li>
				<li>
					<hilliness>Mountainous</hilliness>
					<multiplier>0.5</multiplier>
				</li>
			</resourceHilliness>
		</li>
		<li Class="FactionColonies.ResourceProductionExtension_TileField">
			<extName>TileField</extName>
			<extDesc>Tile environment</extDesc>
			<multipliers>
				<li>
					<field>BiomePlantDensity</field>
					<defaultValue>0.5</defaultValue>
					<curve>
						<points>
							<li>(0.0, 0.4)</li>
							<li>(0.2, 0.8)</li>
							<li>(0.4, 1.1)</li>
							<li>(0.7, 0.95)</li>
							<li>(1.0, 0.85)</li>
						</points>
					</curve>
				</li>
				<li>
					<field>Temperature</field>
					<defaultValue>20</defaultValue>
					<curve>
						<points>
							<li>(-20, 0.4)</li>
							<li>(0, 0.75)</li>
							<li>(15, 1.0)</li>
							<li>(25, 1.1)</li>
							<li>(35, 0.85)</li>
							<li>(45, 0.6)</li>
						</points>
					</curve>
				</li>
				<li>
					<field>Rainfall</field>
					<defaultValue>800</defaultValue>
					<curve>
						<points>
							<li>(0, 0.7)</li>
							<li>(400, 0.9)</li>
							<li>(1000, 1.0)</li>
							<li>(2500, 1.05)</li>
							<li>(5000, 0.95)</li>
						</points>
					</curve>
				</li>
				<li>
					<field>Pollution</field>
					<defaultValue>0</defaultValue>
					<curve>
						<points>
							<li>(0.0, 1.0)</li>
							<li>(0.5, 0.75)</li>
							<li>(1.0, 0.0)</li>
						</points>
					</curve>
				</li>
				<li>
					<field>HasAnyRiver</field>
					<defaultValue>0</defaultValue>
					<curve>
						<points>
							<li>(0, 1.0)</li>
							<li>(1, 1.1)</li>
						</points>
					</curve>
				</li>
			</multipliers>
		</li>
		<!-- Adds the harvested output of any sowable non-tree crop, except outputs in the blocked categories (owned by the medicine resource). Kept last so translation index mappings for the extensions above stay stable. -->
		<li Class="FactionColonies.ResourceFilterExtension_Crops">
			<blockedCategories>
				<li>Medicine</li>
				<li>Drugs</li>
			</blockedCategories>
		</li>
	</modExtensions>
  </FactionColonies.ResourceTypeDef>

