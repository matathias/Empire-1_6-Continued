  <FactionColonies.ResourceTypeDef>
	<defName>RTD_Apparel</defName>
	<label>apparel</label>
	<description>A resource category for apparel.</description>
	<iconPath>GUI/ProductionApparel</iconPath>
	<color>(0.55, 0.45, 0.75)</color>
	<uiPriority>300</uiPriority>
	<isDefaultResource>true</isDefaultResource>
	<productionAdditiveStat>RTD_Apparel_ProductionAdditive</productionAdditiveStat>
	<productionMultiplierStat>RTD_Apparel_ProductionMultiplier</productionMultiplierStat>
	<thingAllowList>
		<!-- Cloth and devilstrand are crop harvests, produced by the farming resource. Synthread/hyperweave are crafted spacer fabrics and stay here. Manufactured leathers/wools (e.g. patchleather) are added dynamically via ResourceFilterExtension_ManufacturedTextiles below. -->
		<li>
			<thingDef>Synthread</thingDef>
			<minTechLevel>Ultra</minTechLevel>
		</li>
		<li>
			<thingDef>Hyperweave</thingDef>
			<minTechLevel>Ultra</minTechLevel>
		</li>
	</thingAllowList>
	<thingCategoryAllowList>
		<li>
			<thingCategoryDef>Apparel</thingCategoryDef>
		</li>
	</thingCategoryAllowList>
	<associatedSkills>
		<li>Crafting</li>
	</associatedSkills>
	<titheMinCount>1</titheMinCount>
	<titheMaxCountBase>5</titheMaxCountBase>
	<titheMaxCountScaler>1</titheMaxCountScaler>
	<modExtensions>
		<!-- Adds manufactured leathers/wools (Leathers/Wools category members not produced directly by an organism, e.g. patchleather). Animal-derived leathers/wools stay with the animal resource. -->
		<li Class="FactionColonies.ResourceFilterExtension_ManufacturedTextiles">
			<categories>
				<li>Leathers</li>
				<li>Wools</li>
			</categories>
		</li>
	</modExtensions>
  </FactionColonies.ResourceTypeDef>

  <FactionColonies.ResourceTypeDef>
	<defName>RTD_Animals</defName>
	<label>animals</label>
	<description>A resource category for livestock and animal products.</description>
	<iconPath>GUI/ProductionAnimals</iconPath>
	<color>(0.75, 0.60, 0.35)</color>
	<uiPriority>400</uiPriority>
	<isDefaultResource>true</isDefaultResource>
	<productionAdditiveStat>RTD_Animals_ProductionAdditive</productionAdditiveStat>
	<productionMultiplierStat>RTD_Animals_ProductionMultiplier</productionMultiplierStat>
	<thingCategoryAllowList>
		<li>
			<thingCategoryDef>MeatRaw</thingCategoryDef>
		</li>
		<li>
			<thingCategoryDef>AnimalProductRaw</thingCategoryDef>
		</li>
		<li>
			<thingCategoryDef>Leathers</thingCategoryDef>
		</li>
		<li>
			<thingCategoryDef>Wools</thingCategoryDef>
		</li>
	</thingCategoryAllowList>
	<thingBlockList>
		<li>Meat_Human</li>
		<li>Leather_Human</li>
	</thingBlockList>
	<associatedSkills>
		<li>Animals</li>
	</associatedSkills>
	<titheMinCount>1</titheMinCount>
	<titheMaxCountBase>3</titheMaxCountBase>
	<titheMaxCountScaler>1</titheMaxCountScaler>
	<modExtensions>
		<li Class="FactionColonies.ResourceFilterExtension_Animals">
			<blacklistedTradeTags>
				<li>AnimalDryad</li>
				<li>AnimalMonster</li>
				<li>AnimalGenetic</li>
			</blacklistedTradeTags>
			<!-- Restrict the Leathers/Wools categories to animal-derived products; blocks manufactured leathers (e.g. patchleather) from the animal resource. -->
			<animalTextileCategories>
				<li>Leathers</li>
				<li>Wools</li>
			</animalTextileCategories>
		</li>
		<li Class="FactionColonies.ResourceProductionExtension_TileField">
			<extName>TileField</extName>
			<extDesc>Tile environment</extDesc>
			<multipliers>
				<li>
					<field>AnimalDensity</field>
					<defaultValue>3.0</defaultValue>
					<curve>
						<points>
							<li>(0.0, 0.5)</li>
							<li>(1.0, 0.8)</li>
							<li>(3.0, 1.0)</li>
							<li>(4.0, 1.1)</li>
							<li>(7.0, 1.3)</li>
						</points>
					</curve>
				</li>
			</multipliers>
		</li>
	</modExtensions>
  </FactionColonies.ResourceTypeDef>

