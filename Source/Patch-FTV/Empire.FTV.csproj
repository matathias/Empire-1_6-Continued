<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <GenerateTargetFrameworkAttribute>false</GenerateTargetFrameworkAttribute>
        <TargetFramework>net10.0</TargetFramework>
        <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
        <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
        <GenerateDependencyFile>false</GenerateDependencyFile>
        <OutputPath>..\..\Compat\1.7\FactionTerritories\Assemblies</OutputPath>
        <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
        <BaseOutputPath>..\..\Compat\1.7\FactionTerritories\Assemblies</BaseOutputPath>
        <Configurations>Debug;Release;Testing</Configurations>
        <PlatformTarget>x64</PlatformTarget>
        <RootNamespace>FactionColonies.FTV</RootNamespace>
        <AssemblyName>Empire.FTV</AssemblyName>
    </PropertyGroup>
    <ItemGroup>
        <!-- Rimworld -->
        <PackageReference Include="Krafs.Rimworld.Ref" Version="1.7.*-*" />
        <PackageReference Include="Lib.Harmony.Ref" Version="3.0.0-rc.3" />
    </ItemGroup>
    <ItemGroup>
      <ProjectReference Include="..\Core\Empire.csproj">
        <Private>False</Private>
      </ProjectReference>
    </ItemGroup>
    <ItemGroup>
        <Reference Include="FactionTerritories">
          <HintPath>..\..\Common\References\FactionTerritories.dll</HintPath>
          <Private>False</Private>
        </Reference>
    </ItemGroup>
</Project>
