<Project Sdk="Microsoft.NET.Sdk">
    <!-- Shared settings (framework, language version, RimWorld/Harmony refs) live in ../Directory.Build.props -->
    <PropertyGroup>
        <OutputPath>..\..\Compat\1.7\GiddyUp\Assemblies</OutputPath>
        <BaseOutputPath>..\..\Compat\1.7\GiddyUp\Assemblies</BaseOutputPath>
        <RootNamespace>FactionColonies.GiddyUpCompat</RootNamespace>
        <AssemblyName>Empire.GiddyUp</AssemblyName>
    </PropertyGroup>
    <ItemGroup>
        <PackageReference Include="Krafs.Publicizer" Version="2.*" />
		<Publicize Include="GiddyUpCore" />
    </ItemGroup>
    <ItemGroup>
      <ProjectReference Include="..\Core\Empire.csproj">
        <Private>False</Private>
      </ProjectReference>
    </ItemGroup>
    <ItemGroup>
        <Reference Include="GiddyUpCore">
          <HintPath>..\..\Common\References\GiddyUpCore.dll</HintPath>
          <Private>False</Private>
        </Reference>
    </ItemGroup>
</Project>
