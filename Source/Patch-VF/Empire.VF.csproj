<Project Sdk="Microsoft.NET.Sdk">
    <!-- Shared settings (framework, language version, RimWorld/Harmony refs) live in ../Directory.Build.props -->
    <PropertyGroup>
        <OutputPath>..\..\Compat\1.7\VehicleFramework\Assemblies</OutputPath>
        <BaseOutputPath>..\..\Compat\1.7\VehicleFramework\Assemblies</BaseOutputPath>
        <RootNamespace>FactionColonies.VF</RootNamespace>
        <AssemblyName>Empire.VF</AssemblyName>
    </PropertyGroup>
    <ItemGroup>
      <ProjectReference Include="..\Core\Empire.csproj">
        <Private>False</Private>
      </ProjectReference>
    </ItemGroup>
    <ItemGroup>
        <Reference Include="Vehicles">
          <HintPath>..\..\Common\References\Vehicles.dll</HintPath>
          <Private>False</Private>
        </Reference>
        <Reference Include="SmashTools">
          <HintPath>..\..\Common\References\SmashTools.dll</HintPath>
          <Private>False</Private>
        </Reference>
    </ItemGroup>
</Project>
